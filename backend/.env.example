# Copy this file to backend/.env for local development.
# Never commit a real API key.

# Preferred provider-neutral settings. The endpoint must implement the
# OpenAI-compatible /v1/chat/completions API and support tool calls.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_PROXY=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
LLM_MAX_TOOL_ROUNDS=4
LLM_THINKING_MODE=
LLM_EXTRA_BODY={}

ASSISTANT_ACTION_EXPIRE_MINUTES=10
ASSISTANT_BACKUP_RETENTION_HOURS=24

# Research document RAG v1: bounded synchronous extraction and full-text retrieval.
# PDF extraction requires pypdf (installed from backend/requirements.txt).
RAG_MAX_FILE_SIZE_BYTES=20971520
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=180
RAG_MAX_CHUNKS_PER_FILE=160
RAG_MAX_EXCEL_CELLS=10000
RAG_MAX_RETRIEVAL_CANDIDATES=400
