# Copy this file to backend/.env for local development.
# Never commit a real API key.

# Preferred provider-neutral settings. The endpoint must implement the
# OpenAI-compatible /v1/chat/completions API and support tool calls.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
LLM_MAX_TOOL_ROUNDS=4
LLM_THINKING_MODE=
LLM_EXTRA_BODY={}

# Legacy DeepSeek settings remain supported when LLM_* is not configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

ASSISTANT_ACTION_EXPIRE_MINUTES=10
ASSISTANT_BACKUP_RETENTION_HOURS=24
