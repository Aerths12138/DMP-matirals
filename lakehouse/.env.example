# Copy to lakehouse/.env only when overriding the development defaults.
LAKEHOUSE_SOURCE=demo
LAKEHOUSE_CATALOG=lakehouse
ICEBERG_WAREHOUSE_URI=file:///warehouse
DMP_JDBC_URL=jdbc:postgresql://postgres:5432/materials_dmp
DMP_JDBC_USER=materials
DMP_JDBC_PASSWORD=CHANGE_ME
DMP_FAIL_ON_QUALITY_ERRORS=false
ICEBERG_S3_ENDPOINT=
ICEBERG_S3_PATH_STYLE_ACCESS=false

# Optional S3 production settings. Set ICEBERG_WAREHOUSE_URI=s3://bucket/path and
# provide the standard AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_REGION
# environment variables to the Spark services.

