FROM spark:4.1.3-scala2.13-java17-python3-ubuntu

ARG ICEBERG_VERSION=1.12.0
ARG POSTGRES_JDBC_VERSION=42.7.8

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    curl --fail --location --retry 4 \
      "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-4.1_2.13/${ICEBERG_VERSION}/iceberg-spark-runtime-4.1_2.13-${ICEBERG_VERSION}.jar" \
      --output "/opt/spark/jars/iceberg-spark-runtime-4.1_2.13-${ICEBERG_VERSION}.jar"; \
    curl --fail --location --retry 4 \
      "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar" \
      --output "/opt/spark/jars/iceberg-aws-bundle-${ICEBERG_VERSION}.jar"; \
    curl --fail --location --retry 4 \
      "https://repo1.maven.org/maven2/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar" \
      --output "/opt/spark/jars/postgresql-${POSTGRES_JDBC_VERSION}.jar"; \
    mkdir -p /warehouse /spark-events; \
    chown -R spark:spark /warehouse /spark-events

WORKDIR /opt/materials-dmp
COPY lakehouse /opt/materials-dmp/lakehouse
COPY lakehouse/conf/spark-defaults.conf /opt/spark/conf/spark-defaults.conf

ENV PYTHONPATH=/opt/materials-dmp

USER spark


