# Copy to .env.production and replace every CHANGE_ME value.
# Start with:
# docker compose --env-file .env.production -f compose.production.yml up -d --build

APP_PORT=8080
CORS_ORIGINS=["http://materials-dmp.internal:8080"]

POSTGRES_USER=materials
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD
POSTGRES_DB=materials_dmp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# OpenAI-compatible local inference endpoint. The backend appends
# /chat/completions, so the base normally ends in /v1.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=CHANGE_ME_TOOL_CALLING_MODEL

# Leave empty only when the internal inference server accepts unauthenticated
# requests from the backend network.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
LLM_MAX_TOOL_ROUNDS=4

# Leave empty unless the selected provider documents a compatible thinking field.
LLM_THINKING_MODE=

# JSON object for provider-specific request fields.
LLM_EXTRA_BODY={"parallel_tool_calls":false}

ASSISTANT_ACTION_EXPIRE_MINUTES=10
ASSISTANT_BACKUP_RETENTION_HOURS=24
